NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_FIREBASE_API_KEY=your-public-web-api-key
# For same-origin Google popup/redirect on Vercel, use your frontend hostname
# after registering its /__/auth/handler in the existing Google OAuth client.
# The committed Vercel rewrite forwards auth helpers to the deen-e-safar project.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-public-web-app-id
# Development emulator only; leave empty for Firebase production authentication.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=
