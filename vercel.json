{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://deen-e-safar.firebaseapp.com/__/auth/:path*" }
  ],
  "headers": [
    { "source": "/__/auth/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
